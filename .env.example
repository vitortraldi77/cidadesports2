# Desenvolvimento (SQLite):
DATABASE_URL="file:./dev.db"

# Produção (Supabase/Postgres) — trocar o provider em prisma/schema.prisma
# para "postgresql" antes de usar:
# DATABASE_URL="postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres"

# Segredo de assinatura do cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=""

# Credenciais do admin usadas pelo seed (prisma/seed.ts).
ADMIN_USUARIO="vitor"
ADMIN_SENHA=""

# Sincronização com o Google Agenda (src/lib/agenda-google). Opcional: sem as
# duas variáveis, o sistema funciona normalmente e só não publica na agenda.
#
# GOOGLE_SERVICE_ACCOUNT_KEY: o conteúdo INTEIRO do .json da service account,
# baixado no Google Cloud. No .env, entre aspas simples e numa linha só; na
# Vercel, cole o arquivo como está.
# GOOGLE_CALENDAR_ID: Configurações da agenda → "Integrar agenda" → "ID da
# agenda". A agenda precisa estar compartilhada com o client_email do .json,
# com a permissão "Fazer alterações nos eventos".
GOOGLE_SERVICE_ACCOUNT_KEY=''
GOOGLE_CALENDAR_ID=""
