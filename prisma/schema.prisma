// Banco: PostgreSQL (Neon, via Vercel Marketplace) em produção e desenvolvimento.
// O schema nasceu portável entre SQLite e Postgres (ver README, seção
// "Migração para produção") e duas escolhas continuam deliberadas mesmo
// depois da migração:
//
// 1. Datas e horas são STRINGS em formato fixo ("YYYY-MM-DD" e "HH:mm"), não
//    DateTime. Uma reserva é um compromisso no calendário de parede da igreja,
//    não um instante absoluto no tempo — guardá-la como DateTime obriga a
//    escolher um fuso e abre a porta para o clássico "a reserva do dia 10
//    aparece como dia 9". Como string, o valor que entra é o valor que sai.
//    Bônus: nesse formato a ordenação lexicográfica é a ordenação cronológica,
//    então comparações e a busca de sobreposição funcionam direto no SQL.
//
// 2. Enums continuam colunas de texto. Os valores válidos vivem em
//    src/lib/schemas.ts (Zod) e são a fonte de verdade — convertê-los em CHECK
//    constraints do Postgres é uma melhoria possível, não obrigatória.
//
// 3. Não há coluna "protocolo" separada: o próprio id autoincremental é o
//    número que o solicitante informa ao Vitor, exibido como "CS-000123".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Reserva {
  id Int @id @default(autoincrement())

  // Dados do solicitante.
  //
  // Opcionais no BANCO porque as reservas importadas do Google Agenda só
  // trazem nome e, às vezes, telefone. Pelo formulário público continuam
  // todos obrigatórios — essa exigência vive no Zod (src/lib/schemas.ts),
  // que é por onde passa todo pedido novo.
  nomeSolicitante String
  dataNascimento  String? // YYYY-MM-DD
  telefone        String? // só dígitos, com DDD
  email           String?

  // Vínculo com a igreja
  tipoVinculo     String?
  codigoMembresia String?

  // Dados da reserva
  espaco     String
  data       String // YYYY-MM-DD
  horaInicio String // HH:mm
  horaFim    String // HH:mm
  finalidade String?

  // Gestão
  status          String  @default("PENDENTE")
  observacaoAdmin String?

  // De onde a reserva veio: "FORMULARIO" (pedido público) ou "GOOGLE_AGENDA"
  // (importada dos lançamentos feitos à mão antes do sistema existir).
  origem String @default("FORMULARIO")

  // Evento correspondente no Google Agenda (ver src/lib/agenda-google).
  //
  // Nulos enquanto a reserva não passou por um status que aparece na agenda.
  // A agenda é guardada junto porque as importadas vêm de mais de uma. O id
  // NÃO é único sozinho: um evento antigo como "Campeonato (Campo, Society e
  // Quadra Coberta)" vira três reservas, uma por espaço — o trio abaixo é que
  // é único, e é ele que impede importar o mesmo evento duas vezes.
  googleCalendarId String?
  googleEventId    String?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  logs         LogAcao[]

  @@unique([googleCalendarId, googleEventId, espaco])
  // Índice da checagem de conflito: mesmo espaço, mesma data, status que ocupa.
  @@index([espaco, data, status])
  // Índice do limite de 1 reserva por responsável por dia.
  @@index([email, data, status])
}

// Agenda fixa: compromisso recorrente criado pelo Vitor direto no painel — um
// treino toda terça, um culto toda sexta — sem passar pelo formulário público
// nem pelo fluxo PENDENTE → APROVADO → CONFIRMADO, porque quem cria já é a
// autoridade que decide.
//
// Não materializa uma linha por semana: é a regra em si (espaço, dia da
// semana, horário, intervalo de vigência), e as ocorrências são calculadas na
// hora — pelo calendário, para desenhar os blocos, e pela checagem de
// conflito, para avisar quando um pedido público esbarra nela.
model AgendaFixa {
  id Int @id @default(autoincrement())

  titulo      String
  responsavel String

  espaco     String
  diaSemana  Int // 0 = domingo ... 6 = sábado
  horaInicio String // HH:mm
  horaFim    String // HH:mm

  dataInicio String // YYYY-MM-DD, a partir de quando a regra vale
  dataFim    String? // YYYY-MM-DD; null = sem data de término

  // Desativar em vez de apagar preserva o registro de que a regra existiu —
  // útil se um pedido antigo referenciar essa observação depois.
  ativa Boolean @default(true)

  // De onde veio: "PAINEL" (criada pelo Vitor) ou "GOOGLE_AGENDA" (importada
  // de uma série que já existia na agenda).
  origem String @default("PAINEL")

  // Evento recorrente ("mestre" da série) no Google Agenda. Mesmo raciocínio
  // da Reserva: uma série do Google pode virar várias agendas fixas — o
  // Colégio Inspire é UMA série de segunda a sexta, e aqui cada agenda fixa
  // tem um só dia da semana; a Escolinha ocupa três espaços.
  googleCalendarId String?
  googleEventId    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([googleCalendarId, googleEventId, espaco, diaSemana])
  // Índice da checagem de conflito: mesmo espaço, mesmo dia da semana, só as ativas.
  @@index([espaco, diaSemana, ativa])
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())
}

// Trilha de auditoria: responde "quem mudou isso, quando e por quê" — a
// primeira pergunta que aparece quando alguém reclama de uma reserva cancelada.
model LogAcao {
  id         Int      @id @default(autoincrement())
  reservaId  Int
  de         String?
  para       String
  observacao String?
  criadoEm   DateTime @default(now())
  reserva    Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@index([reservaId])
}
